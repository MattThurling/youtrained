# /etc/caddy/Caddyfile — TLS via Let's Encrypt, proxy to the app container.
www.youtrained.com {
    redir https://youtrained.com{uri} permanent
}

youtrained.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080 {
        transport http {
            dial_timeout 5s
        }
    }
    # While the app container restarts, answer 503 + Retry-After: crawlers treat that as
    # "come back later" rather than a broken site.
    handle_errors 502 504 {
        header Retry-After 60
        header Cache-Control no-store
        respond "YouTrained is restarting; please retry in a minute." 503
    }
}
